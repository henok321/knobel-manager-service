DOMAIN=api.knobel-manager.de
ACME_EMAIL=you@example.com

DB_USER=knobel
# goes into DATABASE_URL verbatim — keep it URL-safe, e.g. openssl rand -hex 24
DB_PASSWORD=change-me
DB_NAME=knobel

ENVIRONMENT=production
DB_MIGRATION_DIR=/home/appuser/db_migration

# base64 of firebaseServiceAccount.json WITHOUT padding (the app decodes RawStdEncoding):
#   base64 -w0 firebaseServiceAccount.json | tr -d '='
FIREBASE_SECRET=

# Pin to a specific build to roll back, e.g. main-1a2b3c4
IMAGE_TAG=latest

# DATABASE_URL is assembled from DB_* in compose.yaml — do not set it here.
