DOMAIN=api.knobel-manager.de
ACME_EMAIL=you@example.com

DB_USER=knobel
# single-quoted into the DSN, so avoid ' and \ — e.g. openssl rand -hex 24
DB_PASSWORD=change-me
DB_NAME=knobel

ENVIRONMENT=production
DB_MIGRATION_DIR=/home/appuser/db_migration

# must be one line, GNU base64 wraps:  base64 <firebaseServiceAccount.json | tr -d '\n'
FIREBASE_SECRET=

# Pin to a specific build to roll back, e.g. main-1a2b3c4
IMAGE_TAG=latest

# DATABASE_URL is assembled from DB_* in compose.yaml — do not set it here.
